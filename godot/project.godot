; Kitchen Rat — Godot 4 project. Open this folder in Godot 4.7 (Project Manager → Import → godot/project.godot).

config_version=5

[application]

config/name="Kitchen Rat"
config/description="A mother rat sneaks through the house at night to feed her pups."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="rat"

[physics]

common/physics_ticks_per_second=60

[rendering]

lights_and_shadows/positional_shadow/atlas_quadrant_0_subdivision=1

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
textures/vram_compression/import_etc2_astc=true
