# Godot 4 — local editor state, never committed.
# Expanded on the demo-polish branch: local imports and generated files kept
# polluting `git status` and blocking `git pull`. Note .gitignore only covers
# UNTRACKED files — the committed *.import files next to the shipped assets
# stay tracked on purpose (Godot needs them); if the editor rewrites those
# and a pull still refuses, that is a different fix, not an ignore rule.

# Import cache: regenerated by the editor on every open/import.
.godot/

# Generated translations.
*.translation

# Export credentials and build output (CI exports into build/).
export_credentials.cfg
build/

# Textures written by tools/make_textures.py — generated locally from fixed
# seeds and deliberately not committed (the repo carries the generator, not
# the PNGs). The .import sidecars are ignored too, so a pull can replace
# them freely instead of refusing to overwrite untracked files.
assets/textures/wood.png
assets/textures/wood.png.import
assets/textures/wood_dark.png
assets/textures/wood_dark.png.import
assets/textures/fabric.png
assets/textures/fabric.png.import
assets/textures/leather.png
assets/textures/leather.png.import
assets/textures/ceramic_tile.png
assets/textures/ceramic_tile.png.import
assets/textures/metal_matte.png
assets/textures/metal_matte.png.import
assets/textures/cardboard.png
assets/textures/cardboard.png.import
assets/textures/plastic.png
assets/textures/plastic.png.import
assets/textures/counter_stone.png
assets/textures/counter_stone.png.import
