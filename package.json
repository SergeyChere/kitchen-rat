{
  "name": "kitchen-rat",
  "productName": "Kitchen Rat",
  "version": "0.1.0",
  "description": "A stealth game about a mother rat stealing food for her pups while the whole house tries to catch her.",
  "main": "electron/main.js",
  "author": "SergeyChere",
  "repository": {
    "type": "git",
    "url": "https://github.com/SergeyChere/kitchen-rat.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sergeychere.kitchenrat",
    "productName": "Kitchen Rat",
    "files": [
      "electron/**",
      "game/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KitchenRat-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KitchenRat-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
